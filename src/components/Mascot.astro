---
// Mini Gab: a chibi mascot that peeks over the hero headline, follows the cursor
// and reacts to pokes. Driven by the mascot block in src/scripts/site.js.
// Variant parts carry data-show="<faces>"; everything else is always drawn.
---
<div class="mascot" id="mascot" data-face="idle">
  <div class="mascot-bubble" id="mascotBubble" role="status" aria-live="polite"></div>
  <button class="mascot-btn" type="button" aria-label="Poke mini Gab">
    <svg class="mascot-svg" viewBox="0 0 160 160" aria-hidden="true">
      <g class="m-bob">
        <!-- body: leather jacket over a black tee -->
        <g class="m-body">
          <path class="m-ol" d="M14 162 C16 140 26 126 48 120 L64 113 L96 113 L112 120 C134 126 144 140 146 162 Z" fill="#2C303A"/>
          <path d="M66 115 L94 115 L90 162 L70 162 Z" fill="#0D0E11"/>
          <path class="m-ol-thin" d="M64 113 L54 124 L66 146 L72 120 Z M96 113 L106 124 L94 146 L88 120 Z" fill="#3B404C"/>
          <path d="M30 136 C34 130 40 127 46 125" stroke="#5B6271" stroke-width="2.4" fill="none" stroke-linecap="round"/>
          <path d="M126 136 C122 131 117 128 112 126" stroke="#5B6271" stroke-width="2.4" fill="none" stroke-linecap="round"/>
          <circle cx="58" cy="140" r="1.8" fill="#8A909C"/>
          <rect x="68" y="98" width="24" height="20" rx="6" fill="#D49A70"/>
          <path d="M68 108 C74 113 86 113 92 108" stroke="#B97E57" stroke-width="2" fill="none"/>
        </g>

        <g class="m-head">
          <!-- hair, back mass -->
          <path class="m-hairback m-ol" d="M34 74 C26 46 40 20 72 15 C104 11 132 26 130 60 C130 70 128 78 125 82 L36 82 Z" fill="#1F1A1E"/>
          <!-- ears -->
          <g class="m-ears">
            <circle class="m-ol" cx="40" cy="80" r="8.5" fill="#F0BE94"/>
            <circle class="m-ol" cx="120" cy="80" r="8.5" fill="#F0BE94"/>
            <path d="M39 77 C42 79 42 83 39 85" stroke="#C98D63" stroke-width="2" fill="none" stroke-linecap="round"/>
            <path d="M121 77 C118 79 118 83 121 85" stroke="#C98D63" stroke-width="2" fill="none" stroke-linecap="round"/>
          </g>
          <!-- face -->
          <path class="m-ol" d="M40 68 C40 42 120 42 120 68 C120 94 104 111 80 111 C56 111 40 94 40 68 Z" fill="#F4C59C"/>
          <path d="M46 84 C50 98 62 107 80 108 C70 104 58 98 52 86 Z" fill="#E8B086" opacity=".55"/>

          <g class="m-feat">
            <!-- blush -->
            <g class="m-blush">
              <ellipse cx="53" cy="92" rx="7.5" ry="4.6" fill="#F49A86" opacity=".6"/>
              <ellipse cx="107" cy="92" rx="7.5" ry="4.6" fill="#F49A86" opacity=".6"/>
            </g>
            <g data-show="bashful">
              <ellipse cx="53" cy="92" rx="10" ry="6" fill="#F26D6D" opacity=".55"/>
              <ellipse cx="107" cy="92" rx="10" ry="6" fill="#F26D6D" opacity=".55"/>
              <path d="M47 90 l3 -3 M52 91 l3 -3 M57 92 l3 -3 M101 90 l3 -3 M106 91 l3 -3 M111 92 l3 -3" stroke="#D9534F" stroke-width="1.6" stroke-linecap="round"/>
            </g>

            <!-- eyes: open -->
            <g class="m-eye m-eye-l" data-show="idle surprised wink">
              <ellipse cx="64" cy="79" rx="8.6" ry="10.2" fill="#2B1B14"/>
              <ellipse cx="64" cy="83" rx="6" ry="5.6" fill="#5A3826"/>
              <circle cx="61" cy="75" r="3.3" fill="#fff"/>
              <circle cx="67.2" cy="83.6" r="1.6" fill="#fff"/>
            </g>
            <g class="m-eye m-eye-r" data-show="idle surprised">
              <ellipse cx="96" cy="79" rx="8.6" ry="10.2" fill="#2B1B14"/>
              <ellipse cx="96" cy="83" rx="6" ry="5.6" fill="#5A3826"/>
              <circle cx="93" cy="75" r="3.3" fill="#fff"/>
              <circle cx="99.2" cy="83.6" r="1.6" fill="#fff"/>
            </g>
            <!-- eyes: happy arcs ^ ^ -->
            <path data-show="blink heart sparkle delighted bashful" class="m-line" d="M56 82 Q64 72 72 82"/>
            <path data-show="blink heart sparkle delighted bashful wink" class="m-line" d="M88 82 Q96 72 104 82"/>
            <!-- eyes: sleepy -->
            <path data-show="sleepy" class="m-line" d="M56 79 Q64 86 72 79 M88 79 Q96 86 104 79"/>
            <!-- eyes: stars -->
            <g data-show="stars" class="m-stars">
              <path d="M64 69 L66.9 75.6 L74 76.2 L68.6 80.8 L70.3 87.8 L64 84 L57.7 87.8 L59.4 80.8 L54 76.2 L61.1 75.6 Z" fill="#FFC83D" stroke="#2B1B14" stroke-width="2" stroke-linejoin="round"/>
              <path d="M96 69 L98.9 75.6 L106 76.2 L100.6 80.8 L102.3 87.8 L96 84 L89.7 87.8 L91.4 80.8 L86 76.2 L93.1 75.6 Z" fill="#FFC83D" stroke="#2B1B14" stroke-width="2" stroke-linejoin="round"/>
            </g>
            <!-- eyes: dizzy spirals -->
            <path data-show="dizzy" class="m-line m-thin" d="M64 79 m-1.5 0 a1.5 1.5 0 1 1 3 0 a3.5 3.5 0 1 1 -7 0 a5.5 5.5 0 1 1 11 0 a7.5 7.5 0 1 1 -15 0 M96 79 m-1.5 0 a1.5 1.5 0 1 1 3 0 a3.5 3.5 0 1 1 -7 0 a5.5 5.5 0 1 1 11 0 a7.5 7.5 0 1 1 -15 0"/>

            <!-- glasses: thin gold metal frames -->
            <g class="m-glasses">
              <rect x="50" y="68" width="28" height="22" rx="9" fill="rgba(255,255,255,.14)" stroke="#B98A47" stroke-width="2.3"/>
              <rect x="82" y="68" width="28" height="22" rx="9" fill="rgba(255,255,255,.14)" stroke="#B98A47" stroke-width="2.3"/>
              <path d="M78 75 Q80 72.5 82 75" stroke="#B98A47" stroke-width="2.3" fill="none"/>
              <path d="M50 74 L42 72 M110 74 L118 72" stroke="#B98A47" stroke-width="2.3" stroke-linecap="round"/>
              <path d="M54 72 L59 70" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".8"/>
              <path d="M86 72 L91 70" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".8"/>
            </g>

            <!-- brows -->
            <path class="m-brows m-line m-thin" d="M56 63 Q63 60 70 62 M90 62 Q97 60 104 63"/>

            <!-- nose -->
            <path d="M79 88 Q81 90 83 88" stroke="#C98D63" stroke-width="2" fill="none" stroke-linecap="round"/>

            <!-- mouths -->
            <path data-show="idle wink heart sparkle" class="m-line" d="M74 95.5 Q77 99 80 96 Q83 99 86 95.5"/>
            <ellipse data-show="surprised" cx="80" cy="98" rx="4" ry="5" fill="#7A2E2A" stroke="#2B1B14" stroke-width="2.6"/>
            <g data-show="stars delighted">
              <path d="M71 94 Q80 95 89 94 Q88 106 80 106 Q72 106 71 94 Z" fill="#7A2E2A" stroke="#2B1B14" stroke-width="2.6" stroke-linejoin="round"/>
              <path d="M75 102.5 Q80 99.5 85 102.5 Q83 105 80 105 Q77 105 75 102.5 Z" fill="#F07C7C"/>
            </g>
            <path data-show="dizzy" class="m-line m-thin" d="M72 98 q2 -3 4 0 t4 0 t4 0 t4 0"/>
            <path data-show="sleepy bashful" class="m-line" d="M76 97 Q80 99.5 84 97"/>
          </g>

          <!-- hair, front fringe sweeping to the right -->
          <g class="m-hairfront">
            <path class="m-ol" d="M37 70 C33 44 52 24 82 22 C106 21 126 34 125 62 C122 56 119 52 116 50 C117 56 116 60 113 63 C110 55 104 49 98 46 C99 53 96 58 92 61 C90 52 84 46 76 44 C76 50 72 55 66 58 C66 51 62 47 57 46 C56 54 51 60 45 62 C44 57 43 55 42 54 C40 59 38 64 37 70 Z" fill="#1F1A1E"/>
            <path d="M50 38 C60 30 74 27 88 28" stroke="#4E4752" stroke-width="3" fill="none" stroke-linecap="round"/>
            <path d="M96 30 C104 32 110 36 114 41" stroke="#4E4752" stroke-width="2.4" fill="none" stroke-linecap="round"/>
            <path class="m-ol" d="M86 22 C90 13 98 10 104 12 C99 14 96 18 95 23 Z" fill="#1F1A1E"/>
          </g>
        </g>

        <!-- reaction extras -->
        <path data-show="heart" class="m-pop" d="M90 8 C90 2 82 0 80 6 C78 0 70 2 70 8 C70 14 80 18 80 22 C80 18 90 14 90 8 Z" fill="#F2545B" stroke="#2B1B14" stroke-width="2.2" stroke-linejoin="round"/>
        <g data-show="sparkle stars" class="m-pop">
          <path d="M28 22 L30.5 28.5 L37 31 L30.5 33.5 L28 40 L25.5 33.5 L19 31 L25.5 28.5 Z" fill="#FFC83D" stroke="#2B1B14" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M134 14 L136 19 L141 21 L136 23 L134 28 L132 23 L127 21 L132 19 Z" fill="#FFC83D" stroke="#2B1B14" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M140 46 L141.4 49.6 L145 51 L141.4 52.4 L140 56 L138.6 52.4 L135 51 L138.6 49.6 Z" fill="#34D399" stroke="#2B1B14" stroke-width="1.6" stroke-linejoin="round"/>
        </g>
        <g data-show="sleepy" class="m-pop m-zzz" fill="#60A5FA" stroke="#2B1B14" stroke-width="1.4" stroke-linejoin="round">
          <path d="M118 22 h9 l-9 9 h9 v2.4 h-13 l9 -9 h-5 Z"/>
          <path d="M132 8 h7 l-7 7 h7 v2 h-10 l7 -7 h-4 Z"/>
        </g>

        <!-- hands gripping the headline -->
        <g class="m-hands">
          <g class="m-hand m-hand-l">
            <path class="m-ol" d="M30 150 C30 142 36 138 44 138 C52 138 56 142 56 150 C56 156 50 159 43 159 C36 159 30 156 30 150 Z" fill="#F4C59C"/>
            <path d="M38 147 v8 M44 146 v9 M50 147 v8" stroke="#C98D63" stroke-width="2" stroke-linecap="round"/>
          </g>
          <g class="m-hand m-hand-r">
            <path class="m-ol" d="M104 150 C104 142 108 138 116 138 C124 138 130 142 130 150 C130 156 124 159 117 159 C110 159 104 156 104 150 Z" fill="#F4C59C"/>
            <path d="M110 147 v8 M116 146 v9 M122 147 v8" stroke="#C98D63" stroke-width="2" stroke-linecap="round"/>
          </g>
        </g>
      </g>
    </svg>
  </button>
</div>

---
const { pathname } = Astro.url;
const isActive = (path: string) => (path === '/' ? pathname === '/' : pathname.startsWith(path));
const navItems = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
---
<header>
  <nav class="wrap topbar" aria-label="Main">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <defs>
            <linearGradient id="toMarkNav" x1="8" y1="6" x2="56" y2="58" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#93B4FF"/>
              <stop offset="0.5" stop-color="#3B6CF6"/>
              <stop offset="1" stop-color="#1E3A8A"/>
            </linearGradient>
          </defs>
          <g fill="none" stroke="url(#toMarkNav)" stroke-linecap="round">
            <path d="M38.41 8.86 A24 24 0 1 1 8.44 28.16" stroke-width="6.6"/>
            <path d="M22.81 41.19 A13 13 0 1 1 41.96 23.64" stroke-width="6"/>
          </g>
          <circle cx="32" cy="32" r="4.2" fill="url(#toMarkNav)"/>
        </svg>
      </span>
      <span>Gabriel Alisasis</span>
    </a>

    <div class="nav-links" id="navLinks">
      {navItems.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href="#contact" class="nav-contact">Contact</a>
    </div>

    <div class="nav-tools">
      <button class="tool-btn" id="cmdkOpen" aria-label="Search (Ctrl+K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
      <a href="#contact" class="btn btn-primary">Let’s talk</a>
      <button class="tool-btn nav-toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line class="bar bar-top" x1="4" y1="7" x2="20" y2="7"/>
          <line class="bar bar-mid" x1="4" y1="12" x2="20" y2="12"/>
          <line class="bar bar-bot" x1="4" y1="17" x2="20" y2="17"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

---
// mini Gab as a roaming guide: his full-body figure (and a bust for peeking over edges),
// a speech bubble, the teleport FX layer and the quick-answer help card.
// Everything stays hidden until src/scripts/mascot.js wakes him up after the page loads.
import { HAND_SVG } from '../data/mascot';
---
<button class="mg" id="mg" type="button" aria-label="Ask mini Gab, Gab’s sidekick" data-form="body" hidden>
  <span class="mg-fig" aria-hidden="true">
    <span class="mg-body"><span class="mg-sprite"></span></span>
    <span class="mg-bust"><span class="mg-face"></span></span>
  </span>
  <svg class="mg-hand" viewBox="0 0 40 28" aria-hidden="true" set:html={HAND_SVG} />
  <svg class="mg-hand" viewBox="0 0 40 28" aria-hidden="true" set:html={HAND_SVG} />
  <span class="mg-hit" aria-hidden="true"></span>
  <span class="mg-bubble" aria-hidden="true" hidden></span>
</button>
<canvas class="mg-fx" id="mgFx" aria-hidden="true"></canvas>

<div class="mg-help" id="mgHelp" role="dialog" aria-modal="false" aria-labelledby="mgHelpTitle" hidden>
  <div class="mg-help-head">
    <span class="mg-help-av" aria-hidden="true"></span>
    <p class="mg-help-who"><strong id="mgHelpTitle">mini Gab</strong><span>Gab’s sidekick · quick answers</span></p>
    <button class="mg-help-x" id="mgHelpClose" type="button" aria-label="Close">×</button>
  </div>
  <div class="mg-help-log" id="mgLog" aria-live="polite" data-lenis-prevent></div>
  <div class="mg-help-chips" id="mgChips" data-lenis-prevent></div>
  <div class="mg-help-foot">
    <button type="button" id="mgMute" aria-pressed="false">Mute chatter</button>
    <button type="button" id="mgHome">Send mini Gab home</button>
  </div>
</div>
<button class="mg-return" id="mgReturn" type="button" hidden>
  <span class="mg-help-av" aria-hidden="true"></span><span>Bring back mini Gab</span>
</button>

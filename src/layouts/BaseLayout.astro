---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { CONTACT_EMAIL } from '../config';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Gabriel Alisasis">
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#0E1430">

<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<script is:inline>document.documentElement.classList.add('js');</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400..800;1,400..800&family=JetBrains+Mono:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Gabriel Alisasis",
  "jobTitle": "Operations Support & Marketing Automation Specialist",
  "email": "mailto:gabb.alisasis@gmail.com",
  "telephone": "+63-966-198-9672",
  "url": "https://gabrielalisasis.com/",
  "address": { "@type": "PostalAddress", "addressCountry": "PH" },
  "knowsAbout": ["GoHighLevel","Marketing Automation","CRM Operations","Klaviyo","Shopify","React","Supabase","Zapier"],
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "Batangas State University" }
}
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<div class="app-shell">
<Header />

<div class="content-area">
<main id="main">
  <slot />

  <section id="contact" class="contact">
    <div class="wrap contact-grid">
      <div class="contact-intro">
        <span class="sec-kicker">Get in touch</span>
        <h2>Let's automate your operations.</h2>
        <p>GoHighLevel build, CRM cleanup, deliverability rescue, or full operations management — tell me what's slowing your business down and I'll reply personally with next steps.</p>
        <ol class="contact-steps">
          <li><b>1</b><span><strong>Send the form</strong>Two minutes, no prep needed.</span></li>
          <li><b>2</b><span><strong>Free 15-minute audit call</strong>We map what's still manual today.</span></li>
          <li><b>3</b><span><strong>A clear plan and quote</strong>What I'd build, and what it will change.</span></li>
        </ol>
        <div class="contact-direct">
          <span>Prefer to message directly?</span>
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          <a href="https://wa.me/639661989672" target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>

      <form class="contact-form reveal" id="contactForm" data-email={CONTACT_EMAIL} novalidate>
        <input type="hidden" name="_subject" value="New enquiry from the portfolio site">
        <input type="hidden" name="_template" value="table">
        <input type="hidden" name="_captcha" value="false">
        <div class="field-row">
          <label class="field"><span>Name</span><input name="name" type="text" autocomplete="name" required></label>
          <label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required></label>
        </div>
        <label class="field"><span>Business or website <em>optional</em></span><input name="business" type="text" autocomplete="organization"></label>
        <label class="field"><span>What's slowing your business down?</span><textarea name="message" rows="4" required placeholder="e.g. Leads from ads aren't followed up fast enough, our CRM is a mess…"></textarea></label>
        <label class="field"><span>Budget range</span>
          <select name="budget">
            <option value="Not sure yet">Not sure yet</option>
            <option value="Under $500">Under $500</option>
            <option value="$500 – $1,500">$500 – $1,500</option>
            <option value="$1,500 – $5,000">$1,500 – $5,000</option>
            <option value="$5,000+">$5,000+</option>
          </select>
        </label>
        <input type="text" name="_honey" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn btn-primary contact-submit" type="submit">Send message →</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <p>© <span id="year">2026</span> Gabriel Alisasis</p>
    <p>Operations Support &amp; Marketing Automation</p>
  </div>
</footer>
</div>
</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged screenshot" hidden>
  <button class="lightbox-close" id="lightboxClose">✕ Close</button>
  <img id="lightboxImg" src="" alt="">
  <span class="lightbox-cap" id="lightboxCap">Click anywhere or press Esc to close</span>
</div>

<div class="fan-overlay" id="fanOverlay" role="dialog" aria-modal="true" aria-label="Project screenshots" hidden>
  <button class="fan-close" id="fanClose">✕ Close</button>
  <div class="fan-stage" id="fanStage">
    <span class="fan-hint">Click a card to bring it forward</span>
  </div>
</div>

<CommandPalette />

<script>
  import '../scripts/site.js';
</script>
</body>
</html>

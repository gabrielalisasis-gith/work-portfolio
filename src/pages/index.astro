---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    title: 'New lead: <em data-name>Sarah M.</em>',
    sub: 'Website form · Facebook ad',
    time: '0.0s',
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>',
  },
  {
    title: 'Tagged &amp; scored',
    sub: '<span class="demo-chip">hot-lead</span><span class="demo-chip">quote-request</span>',
    time: '0.4s',
    icon: '<path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
  },
  {
    title: 'SMS sent',
    sub: '“Hi <span data-first>Sarah</span>, thanks! Pick a time for your free quote…”',
    time: '1.1s',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    title: 'Call booked',
    sub: 'Tue 10:30 AM · calendar synced',
    time: '4m 12s',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  },
  {
    title: 'Pipeline updated',
    sub: 'Moved to <strong>Booked</strong> · owner notified',
    time: '4m 13s',
    icon: '<rect x="3" y="3" width="5" height="18" rx="1"/><rect x="10" y="3" width="5" height="12" rx="1"/><rect x="17" y="3" width="4" height="8" rx="1"/>',
  },
];
---
<BaseLayout
  title="Gabriel Alisasis – Operations & Automation Specialist"
  description="Gabriel Alisasis – GoHighLevel automation specialist and operations manager. CRM systems, workflow automation, and the operational systems that let businesses scale."
>
  <section class="hero">
    <div class="hero-blob" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="bento-status">Available for new projects</div>
        <h1>Automation that <span class="accent">actually runs.</span></h1>
        <p class="lede">I build <strong>GoHighLevel CRMs, workflows and backend systems</strong> that capture every lead, follow up on their own, and keep running without you babysitting them.</p>
        <div class="hero-ctas">
          <a href="#contact" class="btn btn-primary">Get a free automation audit →</a>
          <a href="/work" class="btn btn-ghost">See client results</a>
        </div>
        <p class="hero-note">Free 15-minute call · No obligation · Remote, worldwide</p>
      </div>

      <div class="hero-demo">
        <div class="demo" id="demo" role="img" aria-label="Example automation: a new lead is tagged, sent an SMS, booked into the calendar and moved in the sales pipeline, with no manual steps.">
          <div class="demo-window" aria-hidden="true">
            <div class="demo-bar">
              <span class="demo-dots"><i></i><i></i><i></i></span>
              <span class="demo-title">Lead → booking workflow</span>
              <span class="demo-live"><b></b>Running</span>
            </div>
            <div class="demo-kpis">
              <div><span>Leads handled</span><strong id="demoCount">1,284</strong></div>
              <div><span>First reply</span><strong>&lt; 60s</strong></div>
              <div><span>Manual steps</span><strong>0</strong></div>
            </div>
            <ol class="demo-steps" id="demoSteps">
              {steps.map((s) => (
                <li class="demo-step">
                  <span class="demo-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} /></span>
                  <span class="demo-txt"><strong set:html={s.title} /><small set:html={s.sub} /></span>
                  <span class="demo-time">{s.time}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="demo-toast demo-toast--booking" aria-hidden="true">
            <span class="demo-toast-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
            <span><strong>New booking</strong><small><span data-name>Sarah M.</span> · Tue 10:30 AM</small></span>
          </div>
          <div class="demo-toast demo-toast--sms" aria-hidden="true">
            <span class="demo-toast-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            <span><strong>SMS delivered</strong><small>Replied in 38 seconds</small></span>
          </div>
        </div>
        <p class="demo-cap">A simplified example of the lead-to-booking workflows I build in GoHighLevel. Simulated data.</p>
      </div>
    </div>
  </section>

  <section class="proof" aria-label="Results and clients">
    <div class="wrap">
      <div class="proof-stats reveal">
        <div class="proof-stat"><strong><span data-count="36000" data-suffix="+">36,000+</span></strong><span>community members, grown from 900 in 8 months</span></div>
        <div class="proof-stat"><strong><span data-count="3000" data-suffix="+">3,000+</span></strong><span>customers supported through CRM operations</span></div>
        <div class="proof-stat"><strong>4</strong><span>client systems live in production</span></div>
        <div class="proof-stat"><strong>3+ yrs</strong><span>building GoHighLevel automations</span></div>
      </div>
      <div class="proof-logos reveal">
        <span class="proof-label">Trusted by</span>
        <ul class="logo-wall">
          <li>Cordelia ARC</li>
          <li>Kemp Beauty</li>
          <li>Sell Ready AI</li>
          <li>Orange Ashes</li>
          <li>LiveHowYouWant</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="dashboard">
    <div class="wrap">
      <div class="bento">

        <a href="/work" class="bento-card span-2 reveal">
          <div class="bento-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="1"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </div>
          <h3>Client work</h3>
          <p>Four builds, live in production: Cordelia ARC, Kemp Beauty, Sell Ready AI, Orange Ashes. Each opens into the full record — what was broken, how I diagnosed it, and what shipped.</p>
          <div class="bento-tags">
            <span class="bento-pill">React + Supabase</span>
            <span class="bento-pill">Klaviyo</span>
            <span class="bento-pill">Shopify Liquid</span>
            <span class="bento-pill">GoHighLevel</span>
          </div>
          <span class="bento-more">View all work →</span>
        </a>

        <a href="/about" class="bento-card reveal">
          <div class="bento-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
          </div>
          <h3>About</h3>
          <p>Background, work history, and a Computer Science degree that means I go as deep as the problem requires.</p>
          <span class="bento-more">Read more →</span>
        </a>

        <div class="bento-card span-3 reveal">
          <div class="bento-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
          </div>
          <h3>Where I plug into your business</h3>
          <p>Each engagement starts the same way an automation does — with a clear trigger and a defined outcome.</p>
          <div class="bento-tags" style="margin-top:18px;">
            <span class="bento-pill">GoHighLevel CRM &amp; Workflow Build</span>
            <span class="bento-pill">Marketing Automation</span>
            <span class="bento-pill">Operations Management</span>
            <span class="bento-pill">Integrations &amp; Zapier</span>
            <span class="bento-pill">Email Deliverability &amp; Klaviyo</span>
            <span class="bento-pill">Storefronts &amp; Web Builds</span>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

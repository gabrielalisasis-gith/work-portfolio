---
import BaseLayout from '../layouts/BaseLayout.astro';
import RowLogo from '../components/RowLogo.astro';
import { brandColor as brand, type Tool } from '../data/brand';
import { WORK_HOURS } from '../config';
import {
  siReact, siTypescript, siNextdotjs, siTailwindcss, siShopify, siSupabase, siPostgresql, siPython, siGit,
  siZapier, siHubspot, siWordpress, siClickup, siTrello, siGooglesheets, siClaude, siHtml5,
} from 'simple-icons';

// 24px line icons (lucide-style)
const I = {
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  merge: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  pages: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>',
  map: '<path d="M9 3 3 6v15l6-3 6 3 6-3V3l-6 3z"/><path d="M9 3v15M15 6v15"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.8-3.8a6 6 0 0 1-7.9 7.9l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 7.9-7.9z"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5"/>',
  check: '<path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/><path d="M22 4 12 14l-3-3"/>',
  talk: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/><path d="M12 8v4M12 16h.01"/>',
  bolt: '<path d="M13 2 3 14h9l-1 8 10-12h-9z"/>',
  code: '<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>',
};

const hours = `${WORK_HOURS.start} AM–${WORK_HOURS.end - 12} PM ${WORK_HOURS.label}`;

const facts = [
  ['4', 'client systems live in production'],
  ['36,000+', 'community members supported'],
  ['3+ yrs', 'building CRM automations'],
  ['BS CS', 'Batangas State University'],
];

// founder problems, in their words, and what each became, tied to a real engagement
// founder problems -> what each became, tied to a real engagement
const handoffs = [
  { icon: 'chat', before: 'Leads wait hours', after: 'Answered instantly', where: 'Supreme Club Tours' },
  { icon: 'copy', before: 'Orders copied by hand', after: 'Delivers itself', where: 'Orange Ashes' },
  { icon: 'mail', before: 'Flows “live”, mail bouncing', after: 'Built, verified, in the inbox', where: 'Kemp Beauty' },
  { icon: 'merge', before: '4 tools, no sync', after: '1 platform', where: 'Cordelia ARC' },
  { icon: 'pages', before: 'Pages stuck in the queue', after: '23+ pages shipped', where: 'Sell Ready AI' },
];

const month = [
  { icon: 'phone', when: 'Day 1', title: '15-min call' },
  { icon: 'map', when: 'Week 1', title: 'Audit & plan' },
  { icon: 'wrench', when: 'Weeks 2–3', title: 'Build & test' },
  { icon: 'rocket', when: 'Week 4', title: 'Live & handed over' },
];

const principles = [
  { icon: 'check', title: 'Tested end to end' },
  { icon: 'talk', title: 'Trade-offs, up front' },
  { icon: 'bolt', title: 'Manual? Automated.' },
  { icon: 'code', title: 'Code where tools stop' },
];

const path = [
  { when: '2021', text: 'CS degree' },
  { when: '2023', text: 'Front-end dev' },
  { when: '2024', text: '3,000+ customers' },
  { when: '2025', text: '900 → 36,000+ members' },
  { when: 'Now', text: 'Client systems, live' },
];

const faq = [
  { q: 'Will our hours overlap?', a: `Yes. I work US business hours: ${hours}, Mon–Fri.` },
  { q: 'How do we communicate?', a: 'Email, video calls, and your team’s workspace (Slack, ClickUp, Monday).' },
  { q: 'How fast do you reply?', a: 'Within 24 hours on weekdays.' },
  { q: 'What do you need to start?', a: 'A 15-minute call, then access to the tools involved.' },
  { q: 'Is this an agency?', a: 'No. You work directly with me.' },
  { q: 'After launch?', a: 'You own everything. Most clients keep me on for improvements.' },
];

// brand logos from Simple Icons (CC0); tools without a published mark get a monogram tile in their brand colour
const toolbox: [string, Tool[]][] = [
  ['Development', [
    { name: 'React', icon: siReact }, { name: 'TypeScript', icon: siTypescript }, { name: 'Next.js', icon: siNextdotjs },
    { name: 'Tailwind', icon: siTailwindcss }, { name: 'Shopify Liquid', icon: siShopify }, { name: 'Supabase', icon: siSupabase },
    { name: 'Postgres', icon: siPostgresql }, { name: 'Python', icon: siPython }, { name: 'Git', icon: siGit },
  ]],
  ['CRM & marketing', [
    { name: 'GoHighLevel', mono: 'GHL', hex: '188BF6' }, { name: 'Klaviyo', mono: 'K', hex: '232426' },
    { name: 'Zapier', icon: siZapier }, { name: 'HubSpot', icon: siHubspot }, { name: 'Salesforce', mono: 'SF', hex: '00A1E0' },
    { name: 'Kommo', mono: 'Ko', hex: '4C8BF5' }, { name: 'Shopify', icon: siShopify }, { name: 'WordPress', icon: siWordpress },
  ]],
  ['Operations', [
    { name: 'ClickUp', icon: siClickup }, { name: 'monday.com', mono: 'm', hex: 'FF3D57' }, { name: 'Trello', icon: siTrello },
    { name: 'Google Sheets', icon: siGooglesheets }, { name: 'ChatGPT', mono: 'GPT', hex: '10A37F' }, { name: 'Claude', icon: siClaude },
  ]],
];
const byName = Object.fromEntries(toolbox.flatMap(([, l]) => l).map((t) => [t.name, t]));
// logos for the usage matrix rows
const rowTool: Record<string, Tool> = {
  'GoHighLevel': byName['GoHighLevel'], 'Klaviyo': byName['Klaviyo'], 'Shopify Liquid': byName['Shopify Liquid'],
  'React / TypeScript': byName['React'], 'Supabase / Postgres': byName['Supabase'],
  'HTML / CSS / JS': { name: 'HTML', icon: siHtml5 }, 'Zapier': byName['Zapier'], 'Git': byName['Git'],
};
---
<BaseLayout
  title="About – Gabriel Alisasis"
  description="Gabriel Alisasis designs, builds and runs CRM, automation and web systems for founders and growing businesses, from the Philippines on US business hours. What he takes off your plate, how the first month works, and how to work together."
>
  <section class="about-hero" id="about">
    <div class="wrap about-hero-grid">
      <div class="about-intro">
        <span class="sec-kicker reveal">About</span>
        <p class="about-hi reveal">Hi, I’m Gab.</p>
        <h1 class="about-title reveal">You run the business. <span class="accent">I run the systems behind it.</span></h1>
        <p class="about-lead reveal">CRMs, automations and web systems that run without you babysitting them.</p>
        <div class="hero-ctas reveal">
          <a href="#contact" class="btn btn-primary">Let's talk →</a>
          <a href="/work" class="btn btn-ghost">See the work</a>
        </div>
        <dl class="about-facts reveal">
          {facts.map(([n, l]) => (<div><dt>{n}</dt><dd>{l}</dd></div>))}
        </dl>
      </div>

      <div class="id-wrap reveal" id="idBadge">
        <div class="id-hang">
        <span class="id-lanyard" aria-hidden="true"></span>
        <div class="id-card" id="clockCard" role="group" data-tz={WORK_HOURS.timeZone} data-start={WORK_HOURS.start} data-end={WORK_HOURS.end} data-days={WORK_HOURS.days.join(',')} aria-label="Gabriel Alisasis: ID card with live availability">
          <span class="id-edge" aria-hidden="true"></span><span class="id-edge" aria-hidden="true"></span><span class="id-edge" aria-hidden="true"></span>

          <div class="id-face id-front">
            <div class="id-top">
              <span class="id-slot" aria-hidden="true"></span>
              <span class="id-org"><b aria-hidden="true">◎</b> TechyOps</span>
              <span class="id-type">Operator</span>
            </div>
            <span class="id-holo" aria-hidden="true"></span>
            <div class="id-body">
              <div class="id-photo">
                <img src="/images/about/gab-id.webp" srcset="/images/about/gab-id-240.webp 240w, /images/about/gab-id.webp 480w" sizes="132px" width="480" height="480" alt="Gabriel Alisasis" fetchpriority="high" decoding="async" draggable="false" />
                <span class="id-seal" aria-hidden="true">TO</span>
              </div>
              <div class="id-who">
                <strong class="id-name">Gabriel Alisasis</strong>
                <span class="id-role">Systems &amp; Automation</span>
                <div class="clock-status" id="clockStatus"><b></b><span>Checking availability…</span></div>
              </div>
            </div>
            <dl class="id-meta">
              <div><dt>Based</dt><dd>Batangas, PH</dd></div>
              <div><dt>Hours</dt><dd>{WORK_HOURS.start} AM–{WORK_HOURS.end - 12} PM ET · Mon–Fri</dd></div>
              <div><dt>Builds</dt><dd>CRM · Automation · Web</dd></div>
            </dl>
            <dl class="id-clocks">
              <div class="is-home"><dt>Batangas</dt><dd data-clock="Asia/Manila">--:--</dd></div>
              <div><dt>New York</dt><dd data-clock="America/New_York">--:--</dd></div>
              <div><dt>Los Angeles</dt><dd data-clock="America/Los_Angeles">--:--</dd></div>
            </dl>
            <div class="id-foot" aria-hidden="true">
              <span class="id-code"></span>
              <span class="id-no">GA · 2021 → NOW</span>
            </div>
          </div>

          <div class="id-face id-back" inert>
            <div class="id-top">
              <span class="id-slot" aria-hidden="true"></span>
              <span class="id-org"><b aria-hidden="true">◎</b> TechyOps</span>
              <span class="id-type">Contact</span>
            </div>
            <div class="id-back-body">
              <p class="id-back-title">Let’s talk.</p>
              <p class="id-back-sub">Reply within 24 hours on weekdays.</p>
              <ul class="id-links">
                <li><a href="mailto:gabb.alisasis@gmail.com"><span>Email</span>gabb.alisasis@gmail.com</a></li>
                <li><a href="https://wa.me/639661989672" target="_blank" rel="noopener"><span>WhatsApp</span>+63 966 198 9672</a></li>
                <li><a href="https://linkedin.com/in/gab-alisasis" target="_blank" rel="noopener"><span>LinkedIn</span>/in/gab-alisasis</a></li>
              </ul>
              <a class="btn btn-primary id-book" href="#contact">Book a free 15-min call →</a>
            </div>
            <div class="id-foot">
              <span class="id-found">If found, hire the owner.</span>
              <span class="id-code" aria-hidden="true"></span>
            </div>
          </div>
        </div>
        </div>
        <button class="id-hint" type="button" aria-controls="clockCard"><span aria-hidden="true">↻</span> <span class="id-hint-text">Flip card</span></button>
      </div>
    </div>
  </section>

  <section class="handoff">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">What founders hand me</span>
        <h2>Bring me the mess. <span class="accent">I’ll hand back a system.</span></h2>
      </div>
      <ul class="handoff-grid">
        {handoffs.map((h) => (
          <li class="handoff-card reveal">
            <span class="handoff-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={I[h.icon]} /></span>
            <span class="hchip is-before"><span class="sr-only">Before: </span>{h.before}</span>
            <span class="handoff-arrow" aria-hidden="true">↓</span>
            <span class="hchip is-after"><span class="sr-only">After: </span>{h.after}</span>
            <span class="handoff-where">{h.where}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="month">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">Working together</span>
        <h2>What your first month looks like.</h2>
      </div>
      <ol class="month-steps">
        {month.map((m) => (
          <li class="month-step reveal">
            <span class="month-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={I[m.icon]} /></span>
            <span class="month-when">{m.when}</span>
            <h3>{m.title}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="principles" id="how-i-work">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">How I work</span>
        <h2>Four rules I don’t bend on.</h2>
      </div>
      <ul class="rule-grid">
        {principles.map((p) => (
          <li class="rule reveal">
            <span class="rule-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={I[p.icon]} /></span>
            <h3>{p.title}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="path">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">The path here</span>
        <h2>The path here.</h2>
      </div>
      <ol class="path-list reveal">
        {path.map((s) => (<li><span class="path-when">{s.when}</span><p>{s.text}</p></li>))}
      </ol>
    </div>
  </section>

  <section id="skills" class="toolkit">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">Stack</span>
        <h2>The tools, and where they were used.</h2>
      </div>
      <div class="matrix-wrap matrix-card reveal">
        <table class="matrix">
                  <caption class="sr-only">Which tools were used on which client engagement</caption>
                  <thead>
                    <tr>
                      <th scope="col">Tool</th>
                      <th scope="col">Cordelia ARC</th>
                      <th scope="col">Kemp Beauty</th>
                      <th scope="col">Sell Ready AI</th>
                      <th scope="col">Orange Ashes</th>
                      <th scope="col">LiveHowYouWant</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['GoHighLevel']} />GoHighLevel</span></th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['Klaviyo']} />Klaviyo</span></th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['Shopify Liquid']} />Shopify Liquid</span></th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['React / TypeScript']} />React / TypeScript</span></th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['Supabase / Postgres']} />Supabase / Postgres</span></th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['HTML / CSS / JS']} />HTML / CSS / JS</span></th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><span class="row-logo is-blank" aria-hidden="true"></span>DNS / DKIM / DMARC</span></th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['Zapier']} />Zapier</span></th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td></tr>
                    <tr><th scope="row"><span class="row-tool"><RowLogo t={rowTool['Git']} />Git</span></th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                  </tbody>
                </table>
      </div>
      <div class="toolbox reveal">
        {toolbox.map(([group, list]) => (
          <div class="tool-group">
            <h4>{group}</h4>
            <ul class="tool-logos">
              {list.map((t) => (
                <li class="tool" style={`--brand:${brand(t)}`}>
                  <span class="tool-logo" aria-hidden="true">
                    {t.icon ? <svg viewBox="0 0 24 24"><path d={t.icon.path} /></svg> : <span class="tool-mono">{t.mono}</span>}
                  </span>
                  <span class="tool-name">{t.name}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="faq">
    <div class="wrap faq-grid">
      <div class="principles-head reveal">
        <span class="sec-kicker">Questions</span>
        <h2>Working together, answered.</h2>
      </div>
      <div class="faq-list reveal">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

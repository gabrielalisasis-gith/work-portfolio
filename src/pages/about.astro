---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WORK_HOURS } from '../config';

const short = [
  { when: '2021–25', text: 'Studied Computer Science at Batangas State University, focused on software development.' },
  { when: '2024–26', text: 'Ran CRM and automation for US businesses, including a community that grew from 900 to 36,000+ members in eight months.' },
  { when: 'Now', text: 'Building and maintaining systems for clients in healthcare, e-commerce and consulting.' },
];

const principles = [
  { title: 'Done means tested with a real signup.',
    body: 'At Kemp Beauty every Klaviyo flow showed green while almost none of the email arrived. I call a job finished when a real test goes through end to end, like a live signup landing in a Gmail inbox.' },
  { title: 'Permissions belong in the database.',
    body: 'On Cordelia ARC’s healthcare platform, every privileged action is checked by row-level security in Postgres. Hiding a button in the interface doesn’t protect anyone’s records.' },
  { title: 'Every change goes through Git.',
    body: 'Theme work for Sell Ready AI and Kemp Beauty is tracked in Git against the live store, so any fix can be reviewed or rolled back.' },
  { title: 'You hear the trade-offs from me.',
    body: 'When I moved Kemp Beauty’s email to an authenticated subdomain, I also flagged that replies to it would never reach the team, and recommended warming the domain slowly.' },
  { title: 'If someone copies it by hand, I automate it.',
    body: 'Orange Ashes orders deliver the moment they’re paid for. WooCommerce bookings open the right CRM opportunity without anyone retyping them.' },
  { title: 'When the builder runs out, I write the code.',
    body: 'GoHighLevel’s store couldn’t do what Orange Ashes needed, so I hand-coded the pieces on top. Cordelia ARC outgrew a CRM entirely, so it became a React and Supabase application.' },
];

const toolbox = [
  ['Development', 'React, TypeScript, Next.js, JavaScript, Tailwind CSS, HTML and CSS, Shopify Liquid, Supabase, Postgres, Python, SQL, Git'],
  ['CRM & marketing', 'GoHighLevel, Klaviyo, Zapier, HubSpot, Salesforce, Kommo, Shopify, WordPress, Meta Business Suite'],
  ['Operations', 'ClickUp, Monday.com, Trello, Google Sheets, Excel, ChatGPT, Claude, Midjourney'],
];
---
<BaseLayout
  title="About – Gabriel Alisasis"
  description="Gabriel Alisasis builds and runs CRM, automation and web systems for US businesses from Batangas, Philippines. How he works, the tools he uses, and when he's online."
>
  <section class="about-hero" id="about">
    <div class="wrap about-hero-grid">
      <div class="about-intro">
        <span class="sec-kicker reveal">About</span>
        <h1 class="about-title reveal">Hi, I’m <span class="accent">Gab.</span></h1>
        <p class="about-lead reveal">Gabriel Alisasis on paper. I set up and run the systems behind growing businesses: GoHighLevel CRMs, automations, email, storefronts, and the occasional full application.</p>
        <p class="about-sub reveal">I work from Batangas in the Philippines, on US business hours, under the name TechyOps.</p>
      </div>

      <div class="portrait-wrap reveal">
        <figure class="portrait" id="portrait" style="--eye-x:44.7%; --eye-y:19.8%">
          <svg class="portrait-halo" viewBox="0 0 64 64" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width=".35">
                <path d="M38.41 8.87 A24 24 0 1 1 8.32 28.12"/>
                <path d="M39.35 5.50 A27.5 27.5 0 1 1 4.86 27.56"/>
                <path d="M37.48 12.25 A20.5 20.5 0 1 1 11.77 28.69"/>
                <path d="M22.81 41.19 A13 13 0 1 1 41.96 23.64"/>
                <path d="M20.69 43.31 A16 16 0 1 1 44.26 21.72"/>
                <path d="M24.93 39.07 A10 10 0 1 1 39.66 25.57"/>
              </g>
              <circle cx="32" cy="32" r="4.2" fill="currentColor" opacity=".5"/>
            </svg>
          <div class="portrait-stage">
            <div class="portrait-zoom">
              <img class="p-img p-off" src="/images/about/gab-no-glasses.webp" srcset="/images/about/gab-no-glasses-640.webp 543w, /images/about/gab-no-glasses.webp 934w" sizes="(max-width: 960px) 420px, 36vw" width="934" height="1100" alt="" aria-hidden="true" fetchpriority="low" decoding="async" />
              <img class="p-img p-on" src="/images/about/gab-glasses.webp" srcset="/images/about/gab-glasses-640.webp 543w, /images/about/gab-glasses.webp 934w" sizes="(max-width: 960px) 420px, 36vw" width="934" height="1100" alt="Gabriel Alisasis in a black leather jacket" fetchpriority="high" decoding="async" />
            </div>
          </div>
        </figure>
        <aside class="clock-card" id="clockCard" data-tz={WORK_HOURS.timeZone} data-start={WORK_HOURS.start} data-end={WORK_HOURS.end} data-days={WORK_HOURS.days.join(',')} aria-label="Current time and availability">
          <div class="clock-status" id="clockStatus"><b></b><span>Checking availability…</span></div>
          <p class="clock-note">Working hours: {WORK_HOURS.start} AM–{WORK_HOURS.end - 12} PM {WORK_HOURS.label}, Mon–Fri</p>
          <dl class="clock-rows">
            <div class="clock-row is-home"><dt>Batangas, PH</dt><dd data-clock="Asia/Manila">--:--</dd></div>
            <div class="clock-row"><dt>New York</dt><dd data-clock="America/New_York">--:--</dd></div>
            <div class="clock-row"><dt>Los Angeles</dt><dd data-clock="America/Los_Angeles">--:--</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="short-version">
    <div class="wrap">
      <span class="sec-kicker reveal">The short version</span>
      <ol class="short-list">
        {short.map((s) => (
          <li class="reveal"><span class="short-when">{s.when}</span><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="principles" id="how-i-work">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">How I work</span>
        <h2>Six rules I don’t bend on.</h2>
      </div>
      <ol class="principle-grid">
        {principles.map((p, i) => (
          <li class="principle reveal">
            <span class="principle-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="skills" class="toolkit">
    <div class="wrap">
      <div class="principles-head reveal">
        <span class="sec-kicker">Stack</span>
        <h2>The tools, and where they were used.</h2>
        <p>Every dot is a real engagement.</p>
      </div>
      <div class="matrix-wrap matrix-card reveal">
        <table class="matrix">
                  <caption class="sr-only">Which tools were used on which client engagement</caption>
                  <thead>
                    <tr>
                      <th scope="col">Tool</th>
                      <th scope="col">Cordelia ARC</th>
                      <th scope="col">Kemp Beauty</th>
                      <th scope="col">Sell Ready AI</th>
                      <th scope="col">Orange Ashes</th>
                      <th scope="col">LiveHowYouWant</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><th scope="row">GoHighLevel</th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td></tr>
                    <tr><th scope="row">Klaviyo</th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row">Shopify Liquid</th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row">React / TypeScript</th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row">Supabase / Postgres</th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row">HTML / CSS / JS</th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row">DNS / DKIM / DMARC</th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                    <tr><th scope="row">Zapier</th>
                      <td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td></tr>
                    <tr><th scope="row">Git</th>
                      <td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-yes"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td><td class="cell-no"><span class="m-dot" aria-hidden="true"></span><span class="sr-only">Not used</span></td></tr>
                  </tbody>
                </table>
      </div>
      <div class="toolbox reveal">
        {toolbox.map(([group, list]) => (
          <div><h4>{group}</h4><p>{list}</p></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cases } from '../../data/cases';

const alts: Record<string, string> = {
    "workflow-edc-ghl": "GoHighLevel workflow builder showing the EDC time-slot form submission trigger branching into contact-tag actions",
    "workflow-multi-venue": "Zapier multi-step zap fanning a new event booking out into six venue-specific paths",
    "workflow-woocommerce": "Zapier workflow splitting a WooCommerce order into shuttle and hotel opportunity paths",
    "workflow-inbox-ai": "Zapier workflow monitoring a Gmail inbox and routing affiliate emails through an AI step into the CRM"
  };
const filters = [
  ['all', 'All work'], ['ghl', 'GoHighLevel'], ['email', 'Email & Klaviyo'], ['shopify', 'Shopify'], ['apps', 'Custom apps'],
];
const countFor = (f: string) => f === 'all' ? cases.length : cases.filter((c) => c.tags.split(' ').includes(f)).length;

const workflows = [
  { img: 'workflow-edc-ghl', w: 1200, h: 633, tag: 'GoHighLevel', cls: 'tag-trigger',
    title: 'EDC time-slot form → shuttle & hotel routing → Google Sheets',
    body: 'Guests submit a form with their arrival time slot. The workflow tags the contact, reads the notes field to work out which shuttle and hotel package applies, and writes the result into the ops Google Sheet so the ground team has it without asking.' },
  { img: 'workflow-multi-venue', w: 1200, h: 674, tag: 'Zapier', cls: 'tag-action',
    title: 'Multi-venue event booking → GoHighLevel contact sync',
    body: 'A new booking arrives from the events calendar and splits into six paths – one per venue across the Vegas and Miami locations. Each path creates or updates the right contact in GoHighLevel with venue-specific tags, so reporting stays clean per property.' },
  { img: 'workflow-woocommerce', w: 1200, h: 677, tag: 'Zapier', cls: 'tag-action',
    title: 'WooCommerce order → shuttle or hotel opportunity',
    body: 'Fires the moment a customer buys a shuttle or hotel package. The order splits on what was purchased, and each path opens the matching opportunity in the CRM pipeline – so sales sees the deal without anyone re-entering it.' },
  { img: 'workflow-inbox-ai', w: 1200, h: 677, tag: 'Zapier + AI', cls: 'tag-trigger',
    title: 'Inbox monitoring → AI affiliate detection → CRM update',
    body: 'Watches a Gmail inbox and splits mail on whether the subject mentions an affiliate. Affiliate email goes to an AI step that extracts the details, which then update the contact record in the CRM automatically.' },
];
---
<BaseLayout
  title="Work – Gabriel Alisasis"
  description="Client results across GoHighLevel, Klaviyo, Shopify and custom software: four production builds, real workflow samples, work history and selected projects."
>
  <section class="work-hero">
    <div class="wrap">
      <span class="sec-kicker reveal">Selected work</span>
      <h1 class="reveal">Systems that are live, <span class="accent">and doing the work.</span></h1>
      <p class="work-lede reveal">Four client builds across GoHighLevel, Klaviyo, Shopify and custom software. Each one opens into the full record — what was broken, how I diagnosed it, what shipped, and the work that has continued since.</p>
      <div class="proof-stats work-stats reveal">
        <div class="proof-stat"><strong>4</strong><span>client systems live in production</span></div>
        <div class="proof-stat"><strong>8</strong><span>failing email flows recovered</span></div>
        <div class="proof-stat"><strong>23</strong><span>landing pages shipped on Shopify</span></div>
        <div class="proof-stat"><strong>24</strong><span>products selling on GoHighLevel</span></div>
      </div>
    </div>
  </section>

  <section id="client-work" class="work-cases">
    <div class="wrap">
      <div class="case-filters reveal" role="group" aria-label="Filter case studies by service">
        {filters.map(([key, label]) => (
          <button class="case-chip" data-case-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>{label} <span>{countFor(key)}</span></button>
        ))}
      </div>
      <div class="case-grid" id="caseGrid">
        {cases.map((c, n) => (
          <article class={`case-card reveal${c.featured ? ' is-featured' : ''}${c.wide ? ' is-featured is-reversed' : ''}`} data-tags={c.tags}>
            <div class="case-media">
              <div class="browser">
                <div class="browser-bar"><i></i><i></i><i></i><span>{c.url}</span></div>
                <img src={`/images/work/${c.img}.webp`} width={c.w} height={c.h} alt={c.alt} loading={n === 0 ? 'eager' : 'lazy'} decoding="async" />
              </div>
            </div>
            <div class="case-body">
              <div class="case-meta"><span class="case-client">{c.client}</span><span>{c.sector}</span>{c.ongoing && <span class="ongoing-badge"><b></b>Ongoing</span>}</div>
              <h2 class="case-title"><a class="case-link" href={`/work/${c.slug}`}>{c.headline}</a></h2>
              <p class="case-summary">{c.summary}</p>
              <ul class="case-metrics">
                {c.metrics.map(([v, l]) => <li><strong>{v}</strong><span>{l}</span></li>)}
              </ul>
              <div class="case-foot">
                <div class="bento-tags">{c.stack.map((t) => <span class="bento-pill">{t}</span>)}</div>
                <div class="case-actions-row">
                  <span class="case-cta">Read case study →</span>
                  <a class="case-visit" href={`https://${c.url}`} target="_blank" rel="noopener">Visit site ↗</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="case-empty" id="caseEmpty" hidden>No case studies in this category yet.</p>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">01</span>
        <div>
          <span class="sec-kicker">Experience</span>
          <h2>Work history</h2>
        </div>
      </div>

      <div class="xp">
        <div class="reveal">
          <div>
            <span class="xp-when">Mar 2025 – Jun 2026</span>
            <span class="xp-where">LiveHowYouWantUSA<br>United States</span>
          </div>
          <div>
            <h3>Operations Support Analyst</h3>
            <ul>
              <li>Managed <strong>GoHighLevel CRM</strong>, workflows, forms, automations, and daily operational processes.</li>
              <li>Maintained Bubble backend workflows and customer data for seamless platform performance.</li>
              <li>Built and managed online communities that scaled from <strong>900 to 36,000+ members in 8 months</strong>.</li>
              <li>Resolved operational issues while improving customer experience and internal efficiency.</li>
            </ul>
            <div class="site-preview">
              <div class="chrome">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="urlbar">livehowyouwant.com</span>
              </div>
              <img class="zoomable site-shot" src="/images/work/xp-livehowyouwant.webp" width="1200" height="760" loading="lazy" decoding="async"
                   alt="Live How You Want homepage – the CRM and community platform">
              <div class="site-body">
                <span>CRM &amp; community platform I helped run</span>
                <a class="visit-btn" href="https://livehowyouwant.com" target="_blank" rel="noopener">Visit ↗</a>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal">
          <div>
            <span class="xp-when">Oct 2024 – Aug 2025</span>
            <span class="xp-where">Supreme Club Tours<br>United States</span>
          </div>
          <div>
            <h3>Marketing Automation Specialist</h3>
            <ul>
              <li>Built GoHighLevel automations for lead capture, nurturing, and customer communication.</li>
              <li>Managed CRM operations supporting growth to <strong>3,000+ customers within 5 months</strong>.</li>
              <li>Managed partnerships with brands including Insomniac, supporting audience growth and bookings.</li>
              <li>Designed marketing assets and promotional materials for Las Vegas nightlife campaigns.</li>
            </ul>
            <div class="site-preview">
              <div class="chrome">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="urlbar">supremeclubtours.com</span>
              </div>
              <img class="zoomable site-shot" src="/images/work/xp-supreme-club-tours.webp" width="1200" height="675" loading="lazy" decoding="async"
                   alt="Supreme Club Tours homepage – Las Vegas nightlife and events booking site">
              <div class="site-body">
                <span>Las Vegas nightlife &amp; events site I supported</span>
                <a class="visit-btn" href="https://supremeclubtours.com" target="_blank" rel="noopener">Visit ↗</a>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal">
          <div>
            <span class="xp-when">Apr 2023 – Sep 2023</span>
            <span class="xp-where">BSU STEER HUB<br>Philippines</span>
          </div>
          <div>
            <h3>Front-End Developer</h3>
            <ul>
              <li>Developed and tested real-time web application features.</li>
              <li>Improved user interface functionality and usability.</li>
              <li>Maintained responsive front-end components and system performance.</li>
              <li>Used performance analytics to optimize content strategy and engagement.</li>
            </ul>
            <div class="site-preview">
              <div class="chrome">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="urlbar">steerhub.batstateu.edu.ph</span>
              </div>
              <img class="zoomable site-shot" src="/images/work/xp-steer-hub.webp" width="1200" height="676" loading="lazy" decoding="async"
                   alt="BSU STEER HUB homepage – the university web application I helped develop">
              <div class="site-body">
                <span>University web app I helped develop</span>
                <a class="visit-btn" href="https://steerhub.batstateu.edu.ph" target="_blank" rel="noopener">Visit ↗</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="workflows">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">02</span>
        <div>
          <span class="sec-kicker">Automation library</span>
          <h2>Inside the automations</h2>
          <p>Real builds pulled straight from GoHighLevel and Zapier – the trigger, the branching logic, and where the data ends up. Click any screenshot to enlarge.</p>
        </div>
      </div>
      <div class="wf-grid">
        {workflows.map((f, n) => (
          <article class="wf-tile reveal">
            <div class="wf-frame">
              <img class="zoomable" src={`/images/work/${f.img}.webp`} width={f.w} height={f.h} alt={alts[f.img]} loading="lazy" decoding="async" />
            </div>
            <div class="wf-tile-body">
              <div class="wf-meta"><span class="n">{String(n + 1).padStart(2, '0')} / 04</span><span class={`tag ${f.cls}`}>{f.tag}</span></div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">03</span>
        <div>
          <span class="sec-kicker">Selected projects</span>
          <h2>Things I've built</h2>
          <p>Filter by discipline – the mix runs from CRM automation through to machine learning.</p>
        </div>
      </div>

      <div class="filter-bar reveal" role="group" aria-label="Filter projects by discipline">
        <button class="chip" data-filter="all" aria-pressed="true">All <span class="count">4</span></button>
        <button class="chip" data-filter="automation" aria-pressed="false">Automation <span class="count">1</span></button>
        <button class="chip" data-filter="fullstack" aria-pressed="false">Full-stack <span class="count">2</span></button>
        <button class="chip" data-filter="frontend" aria-pressed="false">Front-end <span class="count">2</span></button>
        <button class="chip" data-filter="data" aria-pressed="false">Data &amp; AI <span class="count">2</span></button>
      </div>
      <p class="filter-status" id="filterStatus" role="status">Showing all 4 projects</p>

      <div class="projects" id="projectsGrid">
        <div class="project-card reveal" data-tags="automation">
          <span class="p-num">01</span>
          <div>
            <h3>Experience Vegas</h3>
            <span class="loc">Destination ticketing platform · USA</span>
            <ul>
              <li>Developed workflow automations that streamlined customer journeys.</li>
              <li>Managed weekly event listings and promotional content for Las Vegas events.</li>
            </ul>
          </div>
          <div class="project-tags"><span class="tag">GoHighLevel</span><span class="tag">Zapier</span><span class="tag">Ops</span></div>
        </div>

        <div class="project-card reveal" data-tags="fullstack data frontend">
          <span class="p-num">02</span>
          <div>
            <h3>Vision Drive</h3>
            <span class="loc">AI intelligent transport system · Philippines</span>
            <ul>
              <li>Built real-time analytics dashboards using HTML, CSS, JavaScript, Firebase, and Chart.js.</li>
              <li>Developed live vehicle classification and traffic monitoring visualizations.</li>
            </ul>
          </div>
          <div class="project-tags"><span class="tag">JavaScript</span><span class="tag">Firebase</span><span class="tag">Chart.js</span></div>
        </div>

        <div class="project-card reveal" data-tags="data">
          <span class="p-num">03</span>
          <div>
            <h3>Hybrid Fraud Detection System</h3>
            <span class="loc">Capstone project · Philippines</span>
            <ul>
              <li>Developed a fraud detection framework using Python, statistical anomaly detection, and machine learning.</li>
              <li>Applied Z-score analysis and Benford's Law to flag suspicious patterns in insurance claim data.</li>
            </ul>
          </div>
          <div class="project-tags"><span class="tag">Python</span><span class="tag">ML</span><span class="tag">Statistics</span></div>
        </div>

        <div class="project-card reveal" data-tags="fullstack frontend">
          <span class="p-num">04</span>
          <div>
            <h3>University Public Dashboard</h3>
            <span class="loc">Research portal · Philippines</span>
            <ul>
              <li>Built a centralized research portal using Next.js, React.js, Node.js, and Tailwind CSS.</li>
              <li>Integrated APIs and advanced search for improved research accessibility.</li>
            </ul>
          </div>
          <div class="project-tags"><span class="tag">Next.js</span><span class="tag">React</span><span class="tag">Node.js</span><span class="tag">Tailwind</span></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

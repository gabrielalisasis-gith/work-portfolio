---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brands, timeline, atLabel, waitLabel, type Flow } from '../../data/emails';

const ICON: Record<Flow['icon'], string> = {
  welcome: '<path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/>',
  browse: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  site: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  cart: '<circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.4a1 1 0 0 0 1 .8h9.7a1 1 0 0 0 1-.8L21 7H6"/>',
  bag: '<path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  heart: '<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>',
};
const icon = (k: Flow['icon']) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[k]}</svg>`;

// "5 minutes after the trigger", "1 day after email 2"
const whenLine = (n: number, wait: string) => {
  const w = waitLabel(wait);
  if (w === 'Sent instantly') return n === 1 ? 'Sends instantly' : `Sends with email ${n - 1}`;
  return w.replace(' later', n === 1 ? ' after the trigger' : ` after email ${n - 1}`);
};

// one view model for the markup and the explorer script
const model = brands.map((b) => ({
  slug: b.slug, name: b.name, initials: b.initials, tint: b.tint, sender: b.sender,
  flows: b.flows.map((f) => {
    const at = timeline(f);
    return {
      slug: f.slug, name: f.name, trigger: f.trigger, goal: f.goal, startLabel: f.startLabel,
      days: Math.round(at[at.length - 1] / 24),
      emails: f.emails.map((e, i) => ({
        n: i + 1, subject: e.subject, preview: e.preview ?? '', offer: e.offer ?? 0, job: e.job ?? '',
        img: e.img ? `/images/email/${b.slug}/${e.img}` : '', d: e.d, m: e.m,
        at: atLabel(at[i]), when: whenLine(i + 1, e.wait), h: at[i],
      })),
    };
  }),
}));

const flowCount = model.reduce((n, b) => n + b.flows.length, 0);
const emailCount = model.reduce((n, b) => n + b.flows.reduce((m, f) => m + f.emails.length, 0), 0);
const first = model[0], firstFlow = first.flows[0], firstMail = firstFlow.emails[0];
const shown = (f: (typeof model)[number]['flows'][number]) => f.emails.filter((e) => e.img);

// the hero fan: one email from the start, middle and end of the customer journey
const fanPick = [['hh', 'welcome', 1], ['hh', 'checkout', 1], ['hh', 'winback', 9]] as const;
const fan = fanPick.map(([b, f, n]) => {
  const brand = model.find((x) => x.slug === b)!, mail = brand.flows.find((x) => x.slug === f)!.emails[n - 1];
  return { brand, mail };
});

// offer ladders: flows where every step was rendered, so each offer level is read from the email itself
const ladders = ['checkout', 'browse'].map((slug) => {
  const f = first.flows.find((x) => x.slug === slug)!;
  return { name: f.name, startLabel: f.startLabel, steps: f.emails.map((e) => ({ n: e.n, h: e.h, offer: e.offer, subject: e.subject, at: e.at })) };
});
const LW = 520, LH = 190, PAD = { l: 40, r: 12, t: 12, b: 4 };
const xMax = 20 * 24;
const lx = (h: number) => PAD.l + (Math.sqrt(h) / Math.sqrt(xMax)) * (LW - PAD.l - PAD.r);
const ly = (o: number) => PAD.t + (1 - o / 22) * (LH - PAD.t - PAD.b);
const xTicks: [number, string][] = [[1, '1 h'], [24, '1 d'], [72, '3 d'], [168, '7 d'], [336, '14 d'], [480, '20 d']];
const stepPath = (steps: { h: number; offer: number }[]) => {
  let d = `M${lx(0)} ${ly(0)} L${lx(steps[0].h)} ${ly(0)} L${lx(steps[0].h)} ${ly(steps[0].offer)}`;
  for (let i = 1; i < steps.length; i++) d += ` L${lx(steps[i].h)} ${ly(steps[i - 1].offer)} L${lx(steps[i].h)} ${ly(steps[i].offer)}`;
  return d + ` L${lx(xMax)} ${ly(steps[steps.length - 1].offer)}`;
};

const build = [
  ['Pick the trigger', 'Signup, product view, started checkout, first order, 30 quiet days. The moment decides the message.'],
  ['Time the gaps', 'Fast while intent is hot (5 minutes, 3 hours), then wider: 1, 3, 8 days.'],
  ['Ladder the offer', 'Open with a nudge, raise the discount only for people who still haven’t bought.'],
  ['Design for the thumb', 'One idea per email, big buttons, checked at phone width before it ships.'],
  ['Prove it lands', 'Authenticated sender, DMARC aligned, tested with a real signup to a real inbox.'],
];
---
<BaseLayout
  title="Email marketing – Gabriel Alisasis"
  description="Klaviyo welcome, browse, checkout, post-purchase and win-back flows, shown as the real emails customers receive, plus the deliverability work that gets them into the inbox."
>
  <section class="mx-hero">
    <div class="wrap mx-hero-grid">
      <div class="mx-hero-copy">
        <div class="breadcrumb-head mx-crumb"><a href="/work">← All work</a></div>
        <span class="sec-kicker reveal">Email marketing · Klaviyo</span>
        <h1 class="reveal">Emails that follow up for you, <span class="accent">and actually reach the inbox.</span></h1>
        <p class="work-lede reveal">Welcome, browse, checkout, post-purchase and win-back flows I built in Klaviyo. Every email on this page is the real one, rendered from the live account.</p>
        <div class="mx-hero-ctas reveal">
          <a class="btn btn-primary" href="#inbox">Open the inbox ↓</a>
          <a class="btn btn-ghost" href="#deliver">Why they arrive</a>
        </div>
        <div class="proof-stats mx-stats reveal">
          <div class="proof-stat"><strong>{flowCount}</strong><span>live flows</span></div>
          <div class="proof-stat"><strong>{emailCount}</strong><span>automated emails</span></div>
          <div class="proof-stat"><strong>5 min</strong><span>to the first cart reminder</span></div>
          <div class="proof-stat"><strong>10→20%</strong><span>offer ladder, for non-buyers only</span></div>
        </div>
      </div>
      <div class="mx-fan reveal" aria-hidden="true">
        {fan.map(({ brand, mail }, i) => (
          <figure class="mx-fan-phone" style={`--i:${i - 1}`}>
            <div class="mx-fan-notif"><span class="mx-av" style={`--tint:${brand.tint}`}>{brand.initials}</span><span><b>{brand.sender}</b>{mail.subject}</span><time>{mail.at}</time></div>
            <img src={`${mail.img}-m.webp`} width={mail.m![0]} height={mail.m![1]} alt="" loading="eager" decoding="async" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="inbox" class="mx-sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">01</span>
        <div>
          <span class="sec-kicker">Inbox explorer</span>
          <h2>Every email, as the customer gets it</h2>
          <p>Pick a flow, open an email, flip between desktop and phone. The timeline shows when each one sends.</p>
        </div>
      </div>
    </div>
    <div class="wrap mx-wrap-wide">
      <div class="mx-app reveal" id="mxApp" data-brand={first.slug} data-flow={firstFlow.slug} data-n={firstMail.n}>
        <div class="mx-chrome">
          <span class="mx-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="mx-accounts" role="group" aria-label="Brand">
            {model.map((b, i) => (
              <button class="mx-acct" type="button" data-brand={b.slug} aria-pressed={i === 0 ? 'true' : 'false'} style={`--tint:${b.tint}`}>
                <span class="mx-av">{b.initials}</span>{b.name}
                <small>{b.flows.reduce((n, f) => n + f.emails.length, 0)}</small>
              </button>
            ))}
          </div>
          <span class="mx-chrome-meta">Klaviyo · live flows</span>
        </div>

        <div class="mx-body">
          <nav class="mx-folders" aria-label="Flows">
            {model.map((b, bi) => (
              <ul data-brand={b.slug} hidden={bi !== 0}>
                {b.flows.map((f, fi) => (
                  <li>
                    <button class="mx-folder" type="button" data-flow={f.slug} aria-current={bi === 0 && fi === 0 ? 'true' : 'false'}>
                      <span class="mx-folder-ico" set:html={icon(brands[bi].flows[fi].icon)} />
                      <span class="mx-folder-name">{f.name}</span>
                      <span class="mx-count">{f.emails.length}</span>
                    </button>
                  </li>
                ))}
              </ul>
            ))}
          </nav>

          <div class="mx-list" data-lenis-prevent>
            {model.map((b, bi) => b.flows.map((f, fi) => (
              <div class="mx-flow" data-brand={b.slug} data-flow={f.slug} hidden={!(bi === 0 && fi === 0)}>
                <header class="mx-flow-head">
                  <h3>{f.name}</h3>
                  <p>{f.goal}</p>
                  <div class="mx-flow-meta">
                    <span class="mx-trigger"><b>Trigger</b>{f.trigger}</span>
                    <span>{f.emails.length} {f.emails.length === 1 ? 'email' : 'emails'}{f.days > 0 && ` · over ${f.days} days`}</span>
                    {shown(f).length < f.emails.length && <span>{shown(f).length} previewed</span>}
                  </div>
                </header>
                <ol class="mx-rail">
                  <li class="mx-start"><span class="mx-dot" aria-hidden="true"></span>{f.startLabel}</li>
                  {f.emails.map((e) => e.img ? (
                    <li>
                      <button class="mx-row" type="button" data-n={e.n} aria-current={bi === 0 && fi === 0 && e.n === 1 ? 'true' : 'false'}>
                        <span class="mx-dot" aria-hidden="true"></span>
                        <span class="mx-row-top"><span class="mx-from-name">{b.sender}</span><time>{e.at}</time></span>
                        <span class="mx-row-subj">{e.subject}</span>
                        <span class="mx-row-prev">{e.preview}</span>
                        <span class="mx-row-tags">
                          <span class="mx-job">{e.job}</span>
                          {e.offer > 0 && <span class="mx-offer">{e.offer}% off</span>}
                        </span>
                      </button>
                    </li>
                  ) : (
                    <li class="mx-quiet" title="In the flow, preview not included">
                      <span class="mx-dot" aria-hidden="true"></span>
                      <time>{e.at}</time><span class="mx-quiet-subj">{e.subject}</span>
                      {e.offer > 0 && <span class="mx-offer">{e.offer}%</span>}
                    </li>
                  ))}
                </ol>
              </div>
            )))}
          </div>

          <article class="mx-read" id="mxRead" aria-label="Email preview">
            <header class="mx-read-head">
              <div class="mx-read-bar">
                <button class="mx-back" type="button" id="mxBack">← Inbox</button>
                <span class="mx-step" id="mxStep">Email {firstMail.n} of {firstFlow.emails.length} · {firstMail.when}</span>
                <span class="mx-nav">
                  <button type="button" id="mxPrev" aria-label="Previous email" disabled>↑</button>
                  <button type="button" id="mxNext" aria-label="Next email">↓</button>
                </span>
              </div>
              <h3 class="mx-subj" id="mxSubj">{firstMail.subject}</h3>
              <div class="mx-from">
                <span class="mx-av" id="mxAv" style={`--tint:${first.tint}`}>{first.initials}</span>
                <span class="mx-from-txt"><b id="mxSender">{first.sender}</b><span>to Alex</span></span>
                <div class="mx-device" role="group" aria-label="Preview size">
                  <button type="button" data-dev="d" aria-pressed="true">Desktop</button>
                  <button type="button" data-dev="m" aria-pressed="false">Phone</button>
                </div>
              </div>
              <p class="mx-read-job" id="mxJob"><span class="mx-job">{firstMail.job}</span>{firstMail.offer > 0 && <span class="mx-offer">{firstMail.offer}% off</span>}</p>
            </header>
            <div class="mx-stage" id="mxStage" data-dev="d">
              <div class="mx-screen" id="mxScreen" data-lenis-prevent tabindex="0" aria-label="Email, scroll to read">
                <img id="mxImg" src={`${firstMail.img}-d.webp`} width={firstMail.d![0]} height={firstMail.d![1]} alt={`The email “${firstMail.subject}”`} decoding="async" />
              </div>
            </div>
          </article>
        </div>
      </div>
      <p class="mx-note">Rendered from Klaviyo with a placeholder first name. Discount codes are masked.</p>
    </div>
    <script type="application/json" id="mxData" set:html={JSON.stringify(model)} />
  </section>

  <section id="ladder" class="mx-sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">02</span>
        <div>
          <span class="sec-kicker">The offer ladder</span>
          <h2>Discounts climb only for people who don’t buy</h2>
          <p>Each dot is an email. Order at any step and Klaviyo takes them out of the flow, so a day-one buyer never sees the 20% code.</p>
        </div>
      </div>
      <div class="mx-ladders">
        {ladders.map((l) => (
          <figure class="mx-ladder reveal">
            <figcaption><b>{l.name}</b><span>Discount by time since “{l.startLabel.toLowerCase()}”</span></figcaption>
            <div class="mx-plot">
              <svg viewBox={`0 0 ${LW} ${LH}`} role="img" aria-label={`${l.name}: ${l.steps.map((s) => `${s.at} ${s.offer}%`).join(', ')}`}>
                {[10, 15, 20].map((o) => <line class="mx-grid" x1={PAD.l} x2={LW - PAD.r} y1={ly(o)} y2={ly(o)} />)}
                <line class="mx-axis" x1={PAD.l} x2={LW - PAD.r} y1={ly(0)} y2={ly(0)} />
                <path class="mx-area" d={`${stepPath(l.steps)} L${lx(xMax)} ${ly(0)} Z`} />
                <path class="mx-line" d={stepPath(l.steps)} />
                {l.steps.map((s) => (
                  <g class="mx-pt" tabindex="0" aria-label={`Email ${s.n}, ${s.at}, ${s.offer}% off: ${s.subject}`} data-tip={`#${s.n} · ${s.at} · ${s.offer}% off|${s.subject}`}>
                    <circle class="mx-hit" cx={lx(s.h)} cy={ly(s.offer)} r="13" />
                    <circle class="mx-mark" cx={lx(s.h)} cy={ly(s.offer)} r="4.5" />
                  </g>
                ))}
              </svg>
              {[10, 15, 20].map((o) => <span class="mx-yt" style={`top:${(ly(o) / LH) * 100}%;right:${100 - ((PAD.l - 8) / LW) * 100}%`}>{o}%</span>)}
              {xTicks.map(([h, t]) => <span class="mx-xt" style={`left:${(lx(h) / LW) * 100}%`}>{t}</span>)}
              <div class="mx-tip" aria-hidden="true"></div>
            </div>
            <details class="mx-table">
              <summary>View as table</summary>
              <table>
                <thead><tr><th>Email</th><th>Sends</th><th>Offer</th><th>Subject</th></tr></thead>
                <tbody>{l.steps.map((s) => <tr><td>#{s.n}</td><td>{s.at}</td><td>{s.offer}%</td><td>{s.subject}</td></tr>)}</tbody>
              </table>
            </details>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="deliver" class="mx-sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">03</span>
        <div>
          <span class="sec-kicker">Deliverability</span>
          <h2>A live flow is not a delivered email</h2>
          <p>Kemp Beauty’s 8 flows showed “live” in Klaviyo while Gmail bounced the mail. I traced it to the sender domain and moved all 26 emails onto an authenticated one.</p>
        </div>
      </div>
      <div class="mx-lanes reveal">
        <div class="mx-lane is-neg">
          <span class="mx-lane-tag">Before</span>
          <ol>
            <li><b>From: kempbeauty.com</b><span>no DKIM keys</span></li>
            <li><b>DMARC check</b><span>p=reject</span></li>
            <li class="mx-end"><b>550 5.7.26</b><span>bounced, never seen</span></li>
          </ol>
        </div>
        <div class="mx-lane is-pos">
          <span class="mx-lane-tag">After</span>
          <ol>
            <li><b>From: mail.kempbeauty.com</b><span>DKIM verified</span></li>
            <li><b>DMARC check</b><span>aligned, passes</span></li>
            <li class="mx-end"><b>Inbox</b><span>tested with a live signup</span></li>
          </ol>
        </div>
      </div>
      <a class="btn btn-ghost mx-case-link reveal" href="/work/kemp-beauty">Read the Kemp Beauty case study →</a>
    </div>
  </section>

  <section id="build" class="mx-sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="sec-num">04</span>
        <div>
          <span class="sec-kicker">Process</span>
          <h2>How I build a flow</h2>
        </div>
      </div>
      <ol class="mx-steps reveal">
        {build.map(([t, d], i) => (
          <li class="mx-stepcard" style={`--tilt:${[-1.5, 1, -0.5, 1.5, -1][i]}deg`}>
            <span class="mx-stepnum">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseNext from '../../components/CaseNext.astro';
import CaseOngoing from '../../components/CaseOngoing.astro';
---
<BaseLayout title="Orange Ashes – Gabriel Alisasis" description="A real digital storefront, checkout, fulfilment, and branded email, built and run entirely inside GoHighLevel.">
  <div class="page-top-spacer" aria-hidden="true"></div>
  <section id="case">
    <div class="wrap">
      <div class="breadcrumb-head">
        <a href="/work">← All work</a>
        <button id="fanTrigger" class="tag" style="cursor:pointer; margin-left:auto;">⛶ Preview screenshots</button>
      </div>
      <CaseHero slug="orange-ashes" />

      <div class="case-list">
        <article class="case reveal">
          <div class="case-body">
              <div class="pao">
                <div class="pao-col pao-problem">
                  <h4>Problem</h4>
                  <p>The client needed a real digital storefront – instant delivery, working checkout, branded transactional email – but wanted it inside GoHighLevel alongside their CRM rather than as a separate platform to maintain. GHL's store features stop well short of that.</p>
                </div>
                <div class="pao-col pao-approach">
                  <h4>Approach</h4>
                  <ul>
                    <li>Structured <strong>9 collections and 24 products</strong> split by US/CA, with digital delivery configured end to end.</li>
                    <li>Fixed checkout, resolved PayPal sandbox issues, and automated fulfilment so products deliver on purchase.</li>
                    <li>Stood up branded order-confirmation and abandoned-cart email from a <strong>Mailgun-authenticated domain</strong> with working merge tags.</li>
                    <li>Hand-coded HTML, CSS, and JS for the header, footer, shop popup, and a "Hire a VA" landing page – using DevTools to override GHL's internal styles where they fought back.</li>
                  </ul>
                </div>
                <div class="pao-col pao-outcome">
                  <h4>Outcome</h4>
                  <ul>
                    <li>A live store where purchases deliver instantly, with no manual fulfilment step.</li>
                    <li>Pipelines and workflows capturing and nurturing subscribers behind the storefront.</li>
                    <li>Consistent brand execution throughout – clay orange, amber, charcoal, and cream in Montserrat.</li>
                  </ul>
                </div>
              </div>

              <div class="stack-row">
                <span class="pill">GoHighLevel</span><span class="pill">HTML</span><span class="pill">CSS</span>
                <span class="pill">JavaScript</span><span class="pill">Mailgun</span><span class="pill">PayPal</span>
              </div>

              <figure class="case-gallery">
                <img class="zoomable" src="/images/work/orange-ashes-2.webp" width="1200" height="648" loading="lazy" decoding="async"
                     alt="GoHighLevel Sites dashboard listing the store's pages: product list, product details, cart, checkout, thank you, contact, about and the Hire a VA landing page">
                <figcaption>The full page architecture in GoHighLevel – product list, product details, cart, checkout, thank you, contact, about, and the "Hire a VA" landing page, wired together as one store.</figcaption>
              </figure>
            </div>
          
        </article>

      </div>
      <CaseOngoing slug="orange-ashes" />
      <CaseNext slug="orange-ashes" />
    </div>
  </section>
</BaseLayout>
